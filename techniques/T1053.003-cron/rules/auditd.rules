# T1053.003 — cron persistence (drop into /etc/audit/rules.d/)
-w /etc/crontab -p wa -k lb_cron
-w /etc/cron.d/ -p wa -k lb_cron
-w /etc/cron.hourly/ -p wa -k lb_cron
-w /etc/cron.daily/ -p wa -k lb_cron
-w /etc/cron.weekly/ -p wa -k lb_cron
-w /etc/cron.monthly/ -p wa -k lb_cron
-w /var/spool/cron/ -p wa -k lb_cron
-w /usr/bin/crontab -p x -k lb_cron_exec
